{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!drizzle",
      "!**/worker-configuration.d.ts",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "performance": {
        "noImgElement": "off"
      }
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/app/**",
        "src/components/**",
        "src/features/**/*.tsx",
        "src/features/**/actions.ts",
        "src/features/**/*Actions.ts",
        "src/features/mcp/tools/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/db/client": "画面（page・コンポーネント・Server Action）と MCP のツールから DB を直接扱わず、各機能の queries / mutations を経由してください（AGENTS.md の「レイヤー構成」参照）",
                  "@/db/batch": "画面（page・コンポーネント・Server Action）と MCP のツールから DB を直接扱わず、各機能の queries / mutations を経由してください（AGENTS.md の「レイヤー構成」参照）",
                  "drizzle-orm": "画面（page・コンポーネント・Server Action）と MCP のツールから DB を直接扱わず、各機能の queries / mutations を経由してください（AGENTS.md の「レイヤー構成」参照）"
                },
                "patterns": [
                  {
                    "group": ["drizzle-orm/**"],
                    "message": "画面（page・コンポーネント・Server Action）と MCP のツールから DB を直接扱わず、各機能の queries / mutations を経由してください（AGENTS.md の「レイヤー構成」参照）"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
