{
  "name": "@canshi/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev --persist-to ../../.wrangler/state",
    "dev:client": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "preview": "vite build && wrangler preview --ignore-base-config",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@canshi/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.13",
    "react": "19.3.1",
    "react-aria-components": "catalog:",
    "react-dom": "19.3.1",
    "react-icons": "catalog:",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/sql.js": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "sql.js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@12.21.0"
}
