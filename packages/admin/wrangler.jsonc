{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canshi-admin",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],

  // 本番公開ホスト名。メインアプリ（canshi.cateiru.dev）・MCP サーバー
  // （mcp.canshi.cateiru.dev）とは別ホスト名にする。アクセス制御は Workers 全体の
  // Cloudflare Access に任せるため、公開後にこのホスト名が Access で保護されて
  // いることを必ず確認する（docs/deploy.md の「管理画面」節を参照）
  "routes": [{ "pattern": "canshi-admin.cateiru.dev", "custom_domain": true }],
  // 管理画面はカスタムドメインだけで公開し、workers.dev・プレビュー URL は作らない
  "workers_dev": false,
  "preview_urls": false,

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // メインアプリと同じ D1 を参照する。マイグレーションはメインアプリ
  // （リポジトリルートの wrangler.toml・drizzle/）が管理するため、ここでは
  // migrations_dir を持たない。バインディング自体は書き込みもできるが、
  // このパッケージからは SELECT だけを発行する（src/db/queries.ts）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "canshi-db",
      "database_id": "1f5e487e-f87e-4896-8190-1ae4f4347ca3"
    }
  ]
}
