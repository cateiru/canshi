{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canshi-admin",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],

  // 本番公開ホスト名。メインアプリ（canshi.cateiru.dev）・MCP サーバー
  // （mcp.canshi.cateiru.dev）とは別ホスト名にする。アプリ内では認証しないため、
  // デプロイ前に Zero Trust でこのホスト名の Self-hosted アプリケーションを作り、
  // 管理者だけを許可するポリシーを付ける（docs/deploy.md の「管理画面」節を参照）
  "routes": [{ "pattern": "canshi-admin.cateiru.dev", "custom_domain": true }],
  // 本番はカスタムドメインだけで公開し、workers.dev は作らない。
  // Worker Previews（main 以外のブランチで Workers Builds が実行する `wrangler preview`）の
  // workers.dev の URL だけを有効にする。`preview_urls` は `wrangler deploy`（本番のデプロイ）の
  // ときだけ反映される。プレビューの URL（とバージョンの URL）は、この Worker に付けた
  // 管理者だけを許可する Worker 単位の Access で保護する（docs/deploy.md の「管理画面」節を参照）
  "workers_dev": false,
  "preview_urls": true,

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // メインアプリと同じ D1 を参照する。マイグレーションはメインアプリ
  // （リポジトリルートの wrangler.toml・drizzle/）が管理するため、ここでは
  // migrations_dir を持たない。書き込みはユーザーの権限の変更・セッションの削除・
  // 家のメンバーの追加と削除（src/db/queries.ts）と、共通のごはん商品の登録・編集・削除
  // （src/db/catalogFoodProducts.ts）だけにする
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "canshi-db",
      "database_id": "1f5e487e-f87e-4896-8190-1ae4f4347ca3"
    }
  ],

  // メインアプリと同じ R2 バケット。共通のごはん商品の画像の保存・削除だけに使う
  // （src/db/catalogFoodProducts.ts）
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "canshi-media"
    }
  ],

  // Worker Previews の設定。プレビューは上の本番のバインディングを引き継がないため、使うものを
  // ここに書き直す。メインアプリのプレビュー（リポジトリルートの wrangler.toml の [previews]）と
  // 同じプレビュー専用の D1・R2 を使い、本番のデータには触れない。D1 のマイグレーションは
  // メインアプリの `pnpm db:migrate:preview` で適用する
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "canshi-preview-db",
        "database_id": "b88bd1c2-3cb6-4eac-b812-a5680ca44202"
      }
    ],
    "r2_buckets": [
      {
        "binding": "MEDIA_BUCKET",
        "bucket_name": "canshi-media-preview"
      }
    ]
  }
}
