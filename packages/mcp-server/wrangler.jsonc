{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canshi-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],

  // メインアプリ（canshi）Worker の `McpRpc`（src/worker.ts）を呼び出す Service Binding。
  // 公開 URL・DNS を経由しない Worker 間の直接呼び出しのため、メインアプリの
  // Cloudflare Access ポリシーの対象にならない（docs/plans/32_mcp_oidc_overview.md 参照）
  "services": [
    {
      "binding": "MAIN_APP",
      "service": "canshi",
      "entrypoint": "McpRpc"
    }
  ],

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // `@cloudflare/workers-oauth-provider` の標準ストレージ（バインディング名は
  // 固定で `OAUTH_KV`）。本番用の id は `wrangler kv namespace create` で払い出し、
  // デプロイ時に docs/deploy.md の手順に沿って上書きする
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "5fa32d55294d47558036eb8380c49363"
    }
  ],

  // 本番公開ホスト名。cateiru.dev ゾーン配下、メインアプリ（canshi.cateiru.dev）とは
  // 別ホスト名（docs/plans/32_mcp_oidc_overview.md の案C）
  "routes": [{ "pattern": "mcp.canshi.cateiru.dev", "custom_domain": true }],

  // MCP サーバー本体（`CanshiMcp`, `agents` パッケージの `McpAgent`）が
  // セッション状態を保持する Durable Object。バインディング名 `MCP_OBJECT` は
  // `McpAgent.serve()` の既定値（`agents/mcp` の実装が参照する）
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CanshiMcp"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "CanshiMcp"
      }
    ]
  }

  // upstream IdP（Cloudflare Access の SaaS OIDC アプリ）の接続先
  // （ACCESS_TEAM_DOMAIN・ACCESS_CLIENT_ID・ACCESS_AUTHORIZATION_URL・
  // ACCESS_TOKEN_URL・ACCESS_CLIENT_SECRET・OAUTH_STATE_SECRET）は、Access 側で
  // アプリを作成するまで値が確定しないため、ここ（wrangler.jsonc の `vars`）には
  // 置かない。メインアプリの VAPID 鍵と同じパターンで、`.dev.vars`／
  // `wrangler secret put` を使い env.d.ts で型を補う（docs/deploy.md の
  // MCP サーバー節に手順を追記予定）
}
