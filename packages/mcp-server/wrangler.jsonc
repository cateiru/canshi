{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canshi-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],

  // メインアプリ（canshi）Worker の `McpRpc`（src/worker.ts）を呼び出す Service Binding。
  // 公開 URL・DNS を経由しない Worker 間の直接呼び出しのため、メインアプリの
  // Cloudflare Access ポリシーの対象にならない（docs/plans/32_mcp_oidc_overview.md 参照）
  "services": [
    {
      "binding": "MAIN_APP",
      "service": "canshi",
      "entrypoint": "McpRpc"
    }
  ],

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // `@cloudflare/workers-oauth-provider` の標準ストレージ（バインディング名は
  // 固定で `OAUTH_KV`）。本番用の id は `wrangler kv namespace create` で払い出し、
  // デプロイ時に docs/deploy.md の手順に沿って上書きする
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "5fa32d55294d47558036eb8380c49363"
    }
  ],

  // 本番公開ホスト名。cateiru.dev ゾーン配下、メインアプリ（canshi.cateiru.dev）とは
  // 別ホスト名（docs/plans/32_mcp_oidc_overview.md の案C）
  "routes": [{ "pattern": "mcp.canshi.cateiru.dev", "custom_domain": true }],

  // MCP サーバー本体（`CanshiMcp`, `agents` パッケージの `McpAgent`）が
  // セッション状態を保持する Durable Object。バインディング名 `MCP_OBJECT` は
  // `McpAgent.serve()` の既定値（`agents/mcp` の実装が参照する）
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CanshiMcp"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "CanshiMcp"
      }
    ]
  },

  // upstream IdP（Cloudflare Access の SaaS OIDC アプリ）の OIDC discovery URL。
  // authorization/token endpoint・JWKS・issuer はここから導出する
  // （src/auth/discovery.ts 参照）ため機密情報ではなく、`vars` にそのまま置ける。
  // ACCESS_CLIENT_ID・ACCESS_CLIENT_SECRET・OAUTH_STATE_SECRET は
  // `wrangler secret put`／`.dev.vars` で設定する（`.dev.vars.example` 参照）
  "vars": {
    "ACCESS_DISCOVERY_URL": "https://cateiru-fe4.cloudflareaccess.com/cdn-cgi/access/sso/oidc/54068e98f51c633f8d47af149207b7b37acc378306e549f6f474cfb33d55848f/.well-known/openid-configuration"
  }
}
