{
  "name": "canshi",
  "version": "0.80.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "icons:generate": "node scripts/generate-icons.mjs",
    "og:generate": "node scripts/generate-og-image.mjs",
    "bcs:generate": "node scripts/split-bcs-illustrations.mjs",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs",
    "household:link": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/link-household.mts",
    "user:link-email": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/link-user-email.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "vrt": "playwright test --config=playwright.vrt.config.ts",
    "vrt:seed": "wrangler d1 execute DB --local --config wrangler.migrations.toml --file=e2e/fixtures/vrt-seed.sql",
    "vrt:reg": "reg-suit run",
    "vrt:admin": "playwright test --config=playwright.admin-vrt.config.ts",
    "vrt:admin:reg": "reg-suit run --config regconfig.admin.json",
    "vrt:shared": "pnpm --filter @canshi/shared build-storybook && playwright test --config=playwright.shared-vrt.config.ts",
    "vrt:shared:reg": "reg-suit run --config regconfig.shared.json",
    "help:screenshots": "playwright test --config=playwright.help-screenshots.config.ts",
    "cf:preview": "vite build && vite preview",
    "cf:deploy": "vinext-cloudflare deploy",
    "cf-typegen": "cf workers types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.migrations.toml",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.migrations.toml",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --config wrangler.preview-migrations.toml"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@bprogress/next": "3.2.12",
    "@canshi/shared": "workspace:*",
    "@cf-wasm/photon": "^0.4.0",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/calendar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/scatterplot": "^0.99.0",
    "@noble/hashes": "2.4.0",
    "@react-spring/web": "10.1.2",
    "@vinext/cloudflare": "1.4.0",
    "agents": "^0.33.0",
    "drizzle-orm": "catalog:",
    "jose": "^6.2.12",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-aria-components": "catalog:",
    "react-dom": "19.3.1",
    "react-easy-crop": "^6.2.3",
    "react-icons": "catalog:",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@cloudflare/vite-plugin": "2.0.0-rc.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/sql.js": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-rsc": "0.5.39",
    "autoprefixer": "^10.5.5",
    "cf": "1.0.0-rc.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "catalog:",
    "postcss": "^8.5.28",
    "reg-keygen-git-hash-plugin": "^0.14.5",
    "reg-publish-s3-plugin": "^0.14.4",
    "reg-suit": "^0.14.5",
    "sql.js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@12.21.0"
}
