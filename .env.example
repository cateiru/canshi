# ローカル開発用の環境変数サンプル。
# `cp .env.example .env` して利用する。`.env` は Git 管理対象外。
#
# 現時点で必須の環境変数はない。
# シークレットが必要な機能を追加する PR でここに追記する。

NEXT_TELEMETRY_DISABLED=1

# --- メディア（写真・動画）の上限 ---
# 未設定の場合は既定値（画像 10 MB／動画 100 MB／合計 10 GB）を使う。
# 本番（Workers）では wrangler.toml の [vars] またはダッシュボードの環境変数で設定する。
# MEDIA_MAX_IMAGE_BYTES=10485760
# MEDIA_MAX_VIDEO_BYTES=104857600
# MEDIA_STORAGE_LIMIT_BYTES=10737418240

# --- Web Push（29） ---
# `pnpm vapid:generate` で鍵ペアを生成できる。公開鍵はクライアントに埋め込まれるため
# ビルド時に読めるこの .env に必要（秘密鍵は .dev.vars に置く。docs/deploy.md 参照）。
# 未設定でもアプリ自体は動作するが、Push 通知の購読・送信ができない。
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- ログイン（Cloudflare Access の OIDC） ---
# 実行時にだけ使う値のため、この .env ではなく .dev.vars（Git 管理対象外）に設定する
# （docs/deploy.md の「ログイン（Cloudflare Access の OIDC）」参照）。
# 開発環境（next dev）で ACCESS_* が未設定なら、/login はメールアドレスの入力だけで
# ログインする開発用のログインになる。EMAIL_HASH_SALT が未設定なら開発用の SALT を使う。
# ACCESS_DISCOVERY_URL=
# ACCESS_CLIENT_ID=
# ACCESS_CLIENT_SECRET=
# EMAIL_HASH_SALT=
